#!name=Starbucks CN 首页去广告（MITM）
#!desc=通过 HTTPS MITM 改写星巴克中国 App 的首页/启动页 JSON 响应；默认避开登录、会员、点单和支付接口。
#!author=Xu
#!version=1.0.0
#!system=iOS
#!tag=去广告,Starbucks,MITM

[Script]
http-response ^https:\/\/([^\/]+\.)?starbucks\.com\.cn\/.* script-path=starbucks_cn_ad_filter.js, requires-body=true, timeout=10, tag=Starbucks CN 去广告

[MITM]
hostname = %APPEND% *.starbucks.com.cn
