#!tag=去广告,Starbucks,MITM

[Script]
http-response ^https:\/\/([^\/]+\.)?starbucks\.com\.cn\/.* script-path=https://raw.githubusercontent.com/hhhoratioxu/LOON-CONFIG-BY-HORATIOXU/main/Plugin/starbucks_cn_ad_filter.js, requires-body=true, timeout=10, tag=Starbucks CN 去广告, enable=true

[MITM]
hostname = %APPEND% starbucks.com.cn, *.starbucks.com.cn
