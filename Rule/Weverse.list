# Weverse Rules for Loon
# Maintained by Horatio
# Last updated: 2026-08-27
#
# Catch Weverse-owned and Weverse-branded hostnames, including
# *.weverse.io, *.weverseshop.io and Weverse Akamai CDN hostnames.
DOMAIN-KEYWORD,weverse

# Core Weverse domains
DOMAIN-SUFFIX,weverse.io
DOMAIN-SUFFIX,weverseshop.io
DOMAIN-SUFFIX,wevpstatic.net

# Known Weverse media CDN
DOMAIN,weverse-rmcnmv.akamaized.net

# Weverse / NAVER APIs and media infrastructure
DOMAIN,global.apis.naver.com
DOMAIN,weverse-live.pstatic.net
DOMAIN,ssl.pstatic.net

# NAVER logging endpoint used by Weverse
DOMAIN,nelo2-col.navercorp.com
